rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOrgAccount(organizationId) {
      return isSignedIn()
        && request.auth.token.role == 'organization'
        && request.auth.token.organizationId == organizationId;
    }

    function isMember(organizationId) {
      return isSignedIn()
        && request.auth.token.role == 'member'
        && request.auth.token.organizationId == organizationId;
    }

    function isOrgOrMember(organizationId) {
      return isOrgAccount(organizationId) || isMember(organizationId);
    }

    function ownsDoc(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users ─────────────────────────────────────────────────────────────────

    match /users/{uid} {
      // Users can read their own document and create it
      allow read: if ownsDoc(uid);
      allow create: if ownsDoc(uid);
      allow delete: if ownsDoc(uid);
      // Users can update their own document but cannot touch allowSandbox —
      // that field is admin-only (set via Firebase Console or Admin SDK).
      allow update: if ownsDoc(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['allowSandbox']);

      // Admins can read all user documents
      allow read: if isAdmin();

      // Org accounts and members can read their sponsored users
      // (needed for org dashboard Pro counts and legacy data access)
      allow read: if isSignedIn()
        && (request.auth.token.role == 'organization' || request.auth.token.role == 'member')
        && resource.data.sponsoredBy is list
        && resource.data.sponsoredBy.hasAny([request.auth.token.organizationId]);

      // Cloud Functions (admin SDK) bypass these rules entirely

      // ── profiles subcollection ──────────────────────────────────────────────
      match /profiles/{profileId} {
        allow read, write: if ownsDoc(uid);
        allow read: if isSignedIn() && resource.data.isShared == true;
        allow read: if isAdmin();

        match /watchHistory/{date} {
          allow read, write: if ownsDoc(uid);
        }
      }

      // ── notifications subcollection ─────────────────────────────────────────
      // Written by Cloud Functions only. Client may read and mark as viewed.
      match /notifications/{notifId} {
        allow read: if ownsDoc(uid);
        allow update: if ownsDoc(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt', 'actionTaken']);
        allow delete: if ownsDoc(uid);
        allow create: if false;
      }

      // ── following subcollection (LEGACY — kept for old client versions) ───────
      // Each doc: { profileId, sourceUid, organizationId?, memberId?, inviteId, createdAt }
      // New clients no longer write here; Cloud Functions still manage it during migration.
      match /following/{followId} {
        allow read: if ownsDoc(uid);
        allow write: if false; // CF only

        allow update: if ownsDoc(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dailyLimitMinutes', 'skipShufflePlaylistIds']);

        match /watchHistory/{date} {
          allow read, write: if ownsDoc(uid);
        }
      }

      // ── watchHistory subcollection (NEW) ─────────────────────────────────────
      // Single doc per profileId (owned or followed), keyed by date string.
      // Shape: { "2026-05-21": { seconds: 720, isLimitOverridden?: false }, ... }
      match /watchHistory/{profileId} {
        allow read, write: if ownsDoc(uid);
      }
    }

    // ── profiles (root collection, NEW) ──────────────────────────────────────
    // Canonical profile docs for all owned and followed profiles.
    // Shape: { uid, name, color, playlistIds, isShared, followerUids, ... }

    match /profiles/{profileId} {
      // Owner has full access (uid field identifies the owner)
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Followers can read profiles they follow
      // (followerUids is managed by Cloud Functions via arrayUnion/arrayRemove)
      allow read: if isSignedIn()
        && resource.data.followerUids is list
        && request.auth.uid in resource.data.followerUids;

      // Anyone signed in can read publicly shared profiles
      // (profileId is learned via invite link — obscurity provides a baseline gate)
      allow read: if isSignedIn() && resource.data.isShared == true;

      allow read: if isAdmin();
    }

    // ── sponsorshipRequests ───────────────────────────────────────────────────
    // Created when user scans an org invite. Org approves/declines. CF-only writes for approve/decline.

    match /sponsorshipRequests/{requestId} {
      allow read: if isSignedIn() && resource.data.requestingUid == request.auth.uid;
      allow read: if isSignedIn()
        && request.auth.token.role == 'organization'
        && resource.data.organizationId == request.auth.token.organizationId;
      allow read: if isSignedIn()
        && request.auth.token.role == 'member'
        && resource.data.memberId == request.auth.token.memberId;
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.requestingUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isSignedIn()
        && resource.data.requestingUid == request.auth.uid
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // ── profileFollowRequests ─────────────────────────────────────────────────
    // Top-level collection; queries scoped by organizationId, memberId, or requestingUid.

    match /profileFollowRequests/{requestId} {
      // The requesting user can read their own requests
      allow read: if isSignedIn() && resource.data.requestingUid == request.auth.uid;

      // Org accounts can read all requests for their organization
      allow read: if isSignedIn()
        && request.auth.token.role == 'organization'
        && resource.data.organizationId == request.auth.token.organizationId;

      // Members can read requests scoped to their memberId (for their own profiles' follow requests)
      // request.auth.token.memberId is set by the setMemberClaims Cloud Function
      allow read: if isSignedIn()
        && request.auth.token.role == 'member'
        && resource.data.memberId == request.auth.token.memberId;

      // Members can also read all org-level requests when they have org-wide approve access
      // (the memberId filter is applied client-side in ParentApprovalList)
      allow read: if isSignedIn()
        && request.auth.token.role == 'member'
        && resource.data.organizationId == request.auth.token.organizationId;

      // Profile owners can read follow requests for their own profiles
      // (used by ProfileManagement to show follower/pending counts)
      allow read: if isSignedIn() && resource.data.profileOwnerUid == request.auth.uid;

      // Admins can read all
      allow read: if isAdmin();

      // Authenticated users can create a follow request for themselves
      allow create: if isSignedIn()
        && request.resource.data.requestingUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // Only the requesting user can cancel (set status to 'cancelled')
      allow update: if isSignedIn()
        && resource.data.requestingUid == request.auth.uid
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // All other status transitions (approve, decline, revoke) are Cloud Functions only
    }

    // ── organizations ─────────────────────────────────────────────────────────

    match /organizations/{organizationId} {
      allow read: if true; // public — org name/logo/isActive needed for ad serving in mobile app
      allow write: if isAdmin();
      // Org accounts can update their own document (Edit Profile, settings) but only
      // a safe set of fields — never billing/cost/sponsorship fields (costs,
      // isSponsoring, billingActive, stripeCustomerId, billingStartDate, billingStatus,
      // cancelAtPeriodEnd, cancelAt), which stay admin-only. Unchanged keys aren't in
      // the diff, so an org save that leaves those fields alone still passes.
      allow update: if isOrgAccount(organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'logo', 'address', 'phone', 'website', 'email',
          'roles', 'isActive', 'requiresProfileFollowApproval',
          'memberCanApproveFollows', 'sponsorshipApprovalRole'
        ]);
    }

    // ── members ───────────────────────────────────────────────────────────────

    match /members/{memberId} {
      allow read: if isAdmin()
        || isOrgAccount(resource.data.organizationId)
        || (isSignedIn() && request.auth.uid == resource.data.authUid);

      // Members can write their own authUid field (written by EmailSignInAction after sign-in).
      // Also allows re-writing the same uid (idempotent) so resent invite links still work.
      // Requires a verified token for the member's own email (mirrors the affiliate
      // claim rule) so an unclaimed member doc can't be hijacked by a signed-in user
      // who didn't prove ownership of the invited email.
      allow update: if isSignedIn()
        && request.auth.uid == request.resource.data.authUid
        && (resource.data.authUid == null || resource.data.authUid == request.auth.uid)
        && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']);

      allow create: if isAdmin()
        || (isOrgAccount(request.resource.data.organizationId));
      allow delete: if isAdmin();
      allow update: if isAdmin() || isOrgAccount(resource.data.organizationId);
    }

    // ── ads (subcollection under organizations) ───────────────────────────────

    match /organizations/{organizationId}/ads/{adId} {
      allow read: if true;
      allow write: if isAdmin() || isOrgAccount(organizationId);
    }

    // Required for collectionGroup('ads') queries used by admin dashboard
    match /{path=**}/ads/{adId} {
      allow read: if true;
    }

    // ── shortLinks ────────────────────────────────────────────────────────────

    match /shortLinks/{linkId} {
      // get-by-id stays public so the app and handleDeeplink can resolve a link the
      // user already holds. Listing/querying requires auth: it previously let anyone
      // enumerate the whole collection (e.g. unclaimed member-invite links), which
      // combined with completeMemberAppSignIn enabled member-account takeover.
      allow get: if true;
      allow list: if isSignedIn();
      // Org members may manage their org's links but can never re-point a link
      // at a different organization.
      allow write: if isAdmin()
        || (isOrgOrMember(resource.data.params.organizationId)
            && (request.method == 'delete'
                || request.resource.data.params.organizationId == resource.data.params.organizationId));
    }

    // ── invites (shortLinks sub-documents) ────────────────────────────────────

    match /invites/{inviteId} {
      allow read: if true;
      allow write: if isAdmin()
        || (isOrgOrMember(resource.data.organizationId)
            && (request.method == 'delete'
                || request.resource.data.organizationId == resource.data.organizationId));
    }

    // ── deviceSessions ────────────────────────────────────────────────────────

    match /deviceSessions/{sessionId} {
      // Device reads its own session while unauthenticated — the random sessionId is the secret.
      // Writes are cloud-function only (admin SDK bypasses rules), with one exception:
      // after the device signs in with the session's customToken, it nulls the token
      // so it can't be read again for the rest of the doc's TTL.
      allow read: if true;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customToken'])
        && request.resource.data.customToken == null;
      allow create, delete: if false;
    }

    // ── scannedPlaylists (import tracking) ───────────────────────────────────

    match /scannedPlaylists/{docId} {
      allow read: if true;
      // Content fields (title, isApproved, …) are written only by Cloud Functions
      // (savePlaylistFromExtension). Clients may only bump the importCount counter.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['importCount']);
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['importCount']);
      allow delete: if false;
    }

    // ── playlistIdIndex ───────────────────────────────────────────────────────

    match /playlistIdIndex/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // ── orgSponsors (billing / sponsorship tracking) ─────────────────────────
    // orgSponsors/{orgId}/users/{uid}

    match /orgSponsors/{organizationId}/users/{uid} {
      allow read: if isAdmin()
        || isOrgAccount(organizationId)
        || isMember(organizationId);
      // Writes are admin-SDK only (cloud functions)
      allow write: if false;
    }

    // ── leads (Sam CRM) ───────────────────────────────────────────────────────
    // Sam app writes via anonymous auth. Web admin reads/writes/deletes via admin role.

    match /leads/{leadId} {
      allow read, create, update: if request.auth.uid == 'poPjm1Ngw9aKnzcB6HwZSkewB392' || isAdmin();
      allow delete: if isAdmin();
    }

    // ── sam (conversation history) ────────────────────────────────────────────
    // Sam app reads/writes its own conversation history. Web admin has read access.

    match /sam/{convId} {
      allow read, write: if request.auth.uid == 'poPjm1Ngw9aKnzcB6HwZSkewB392' || isAdmin();
    }

    // ── affiliates ────────────────────────────────────────────────────────────
    // Used for both ad-network organizations (type: 'organization') and
    // influencer affiliate partners (type: 'influencer').

    match /affiliates/{affiliateId} {
      // Admins have full access
      allow read, write: if isAdmin();

      // Public read for slug pointer docs only. Full affiliate docs are never public —
      // they hold payout info and internal notes; the public page reads the sanitized
      // mirror at affiliates/{id}/public/profile instead.
      // resource == null means the document doesn't exist (slug is available) — allow so
      // the client can confirm availability without a permission error.
      allow read: if resource == null || resource.data.type == 'slug';

      // Fast path: matched by authUid (set after first sign-in)
      allow read: if isSignedIn() && resource.data.authUid == request.auth.uid;

      // First sign-in: authUid is still null — allow read by email.
      // email_verified is required: token.email exists on unverified password accounts too.
      // Firestore can verify this constraint for queries using where('email', '==', ...).
      // Once claimed (authUid set), only the authUid fast path above applies, so a
      // later registration of the same email can't read someone's claimed account.
      allow read: if isSignedIn()
        && resource.data.authUid == null
        && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email;

      // Affiliate can write authUid on first magic-link sign-in (authUid starts null).
      // The caller must hold a verified token for the affiliate's own email, and may
      // only claim the doc for themselves — never write someone else's uid.
      allow update: if isSignedIn()
        && (resource.data.authUid == null || resource.data.authUid == request.auth.uid)
        && request.resource.data.authUid == request.auth.uid
        && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'claimedAt']);

      // Affiliate can update their own profile fields, payout info, and onboarding state
      allow update: if isSignedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paypalEmail', 'payoutMethod', 'photo', 'bio', 'title', 'name', 'website', 'websiteSummary', 'websiteKeywords', 'onboardingCompletedAt', 'affiliateTermsAgreedAt', 'socialLinks', 'claimedAt']);

      // publicProfiles subcollection — public read for vidopick.com; created/removed by
      // Cloud Functions (addPublicProfile/removePublicProfile). The owning affiliate may
      // edit only the `description` of their own entries; everything else is admin-only.
      match /publicProfiles/{profileId} {
        allow read: if true;
        allow write: if isAdmin();
        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description']);
      }

      // Public profile doc (affiliates/{id}/public/profile) — single source of truth
      // for display fields. The affiliate writes their own profile fields directly here.
      // System fields (slug, isPublic, isHidden, updatedAt) are written by Cloud Functions.
      match /public/{docId} {
        allow read: if true;
        allow write: if isAdmin();
        allow create: if docId == 'profile'
          && isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'bio', 'title', 'photo', 'website', 'socialLinks']);
        allow update: if docId == 'profile'
          && isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'title', 'photo', 'website', 'socialLinks']);
      }

      // Internal admin notes — never visible to the affiliate or the public.
      match /private/{docId} {
        allow read, write: if isAdmin();
      }

      // Generated copy history — one doc per generation, affiliate owns their own.
      match /generatedCopy/{copyId} {
        allow read, write: if isAdmin();
        allow read, create: if isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid;
        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['variations', 'savedAt']);
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid;
      }

      // AI copywriting instructions — affiliate manages their own.
      match /instructions/{instructionId} {
        allow read, write: if isAdmin();
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid;
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['title', 'description', 'createdAt']);
        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description']);
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid;
      }

      // Commissions subcollection — affiliate reads their own; only Cloud Functions write.
      // Two rules cover the same user: fast path (authUid) and email fallback for the
      // first-sign-in window before authUid is written (verified emails only).
      // get() is cached per document read.
      match /commissions/{commissionId} {
        allow read: if isAdmin();
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid
          || (request.auth.token.email_verified == true
              && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == null
              && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.email == request.auth.token.email)
        );
      }

      match /dailyStats/{dateId} {
        allow read: if isAdmin();
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == request.auth.uid
          || (request.auth.token.email_verified == true
              && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.authUid == null
              && get(/databases/$(database)/documents/affiliates/$(affiliateId)).data.email == request.auth.token.email)
        );
      }
    }

    // ── affiliatesOutreach ───────────────────────────────────────────────────
    // Admin-only. Cloud Functions (resendOutreachWebhook, sendAffiliateOutreachEmail)
    // use Admin SDK and bypass these rules.

    match /affiliatesOutreach/{leadId} {
      allow read, write: if isAdmin();
    }

    // ── collectionGroup: affiliates/*/public ─────────────────────────────────
    // Allows the /creators/ page to query all public profile docs across all
    // affiliates without exposing the parent affiliate doc (which holds payout info).

    match /{path=**}/public/{docId} {
      allow read: if true;
    }

    // ── Deny everything else ──────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
