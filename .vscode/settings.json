{
  // VSCode
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "explorer.confirmDragAndDrop": false,
  "search.exclude": {
    "**/node_modules": false,
    "**/node_modules/**": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.formatOnSave": true,
  // ESlint
  "eslint.enable": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  // Extensions
  "todo-tree.general.tags": ["BUG", "HACK", "FIXME", "TODO", "IMPORTANT", "TEMPORARY"],
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "gutterIcon": true
    },
    "BUG": {
      "icon": "bug",
      "iconColour": "#FF0000",
      "foreground": "#ffffff",
      "background": "#FF0000",
      "gutterIcon": true
    },
    "IMPORTANT": {
      "icon": "alert",
      "iconColour": "#FFA500",
      "foreground": "#6d4008",
      "background": "#FFA500",
      "gutterIcon": true
    },
    "TEMPORARY": {
      "icon": "info",
      "iconColour": "#FFFF00",
      "foreground": "#6d4008",
      "background": "#FFFF00",
      "gutterIcon": true
    },
    "NOTE": {
      "icon": "info",
      "iconColour": "#33ff00",
      "foreground": "#ffffff",
      "background": "#33ff00",
      "gutterIcon": true
    }
  },
  // TODO
  // IMPORTANT
  // BUG
  // TEMPORARY
  // NOTE

  // Code Spell Checker
  "cSpell.enabledFileTypes": {
    // Enable spell checking for these file types
    "markdown": true,
    "plaintext": true,
    "typescript": true,
    "typescriptreact": true
  },
  "cSpell.ignorePaths": ["**/node_modules/**"],
  "cSpell.languageSettings": [
    {
      "languageId": "typescript",
      "includeRegExpList": ["/(\\/\\*[^]*?\\*\\/|\\/\\/[^\\n]*$)/gm"], // Include spelling for C-style comments: single-line comments with // and multi-line comments with /*
      "ignoreRegExpList": ["/'.*?'/g"] // Ignore words inside single quotes
    },
    {
      "languageId": "typescriptreact",
      "includeRegExpList": ["/(\\/\\*[^]*?\\*\\/|\\/\\/[^\\n]*$)/gm"], // Include spelling for C-style comments: single-line comments with // and multi-line comments with /*
      "ignoreRegExpList": ["/'.*?'/g"] // Ignore words inside single quotes
    },
    {
      "languageId": "markdown",
      "includeRegExpList": [],
      "ignoreRegExpList": []
    }
  ],
  // Ensure gitignored files are not excluded
  "cSpell.useGitignore": false,
  // Add custom words to dictionary
  "cSpell.words": ["carhonk", "Colour", "esbenp", "kickbk", "NHTSA", "pressable", "typeguard"],
  "vscode-color-picker.languages": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ]
}
